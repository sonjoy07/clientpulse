# ==============================================================================
# ClientPulse Backend — Environment Configuration Template
# ==============================================================================

# Application & Runtime
# 'development', 'production', or 'test'
NODE_ENV=development
# Port to listen on (Render automatically provides PORT=10000)
PORT=4000

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL and preview URLs)
# In production, requests from unlisted origins will be rejected.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Database Configuration (PostgreSQL / Docker / Render / Supabase)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clientpulse

# Main connection string used by the API runtime and Prisma Client
# For Docker VPS: postgresql://postgres:postgres@postgres:5432/clientpulse?schema=public
# For Local Dev: postgresql://postgres:postgres@localhost:5432/clientpulse?schema=public
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/clientpulse?schema=public

# Direct Database URL for Prisma Migrations
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/clientpulse?schema=public

# Authentication & Cryptographic Security
# REQUIRED in production: Must be unique, random, and at least 32 characters long.
# Generate via: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-secure-random-32-char-secret-key-for-access
JWT_REFRESH_SECRET=replace-with-a-secure-random-32-char-secret-key-for-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis & BullMQ Queue Configuration
# Render Redis / Upstash / Managed Redis connection URL
# Takes precedence over individual host/port settings if provided.
# Example: redis://red-xxxx:6379 or rediss://default:xxxx@xxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Fallback individual Redis parameters (used if REDIS_URL is not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set to 'true' if connecting over TLS (e.g. Upstash or Render External Redis)
REDIS_TLS=false

# AI Weekly Status Report Generator
# Options: 'mock' (safe fallback without external API calls) or 'openai'
AI_PROVIDER=mock
# Required if AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_REPORT_MAX_TOKENS=1200
AI_REPORT_TEMPERATURE=0.2
