# Backend API Base URL
# Must point to the public HTTP endpoint where the NestJS API is hosted, including the /api/v1 prefix.
# Local Development: http://localhost:4000/api/v1
# Production (Vercel): https://your-clientpulse-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
